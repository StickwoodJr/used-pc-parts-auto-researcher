# ==============================================================================
# PC Parts Search & Tracker Configuration
# Copy this file to .env and fill in your credentials.
# ==============================================================================

# eBay Developer Program Application Credentials
# Register for free at https://developer.ebay.com/
EBAY_CLIENT_ID=your_ebay_client_id_here
EBAY_CLIENT_SECRET=your_ebay_client_secret_here
EBAY_ENVIRONMENT=PRODUCTION

# Google Sheets API Credentials
# Create a Google Cloud Service Account and download the JSON key file.
# Share your target Google Sheet with the service account's client_email.
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
GOOGLE_SHEET_TITLE=PC Parts Search - CPU & RAM
GOOGLE_SHEET_TAB_NAME=Listings

# Location & Proximity Search Filters (Newmarket, ON)
SEARCH_POSTAL_CODE=L3Y8B4
SEARCH_RADIUS_KM=20

# Scam Flagging Price Thresholds (in CAD)
CPU_SCAM_PRICE_THRESHOLD=20.0
RAM_SCAM_PRICE_THRESHOLD=10.0
